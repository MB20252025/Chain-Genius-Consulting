##[group]Run echo "runner started: $(date -u +%FT%TZ)" >> "$RUN_DIR/meta.txt"
echo "runner started: $(date -u +%FT%TZ)" >> "$RUN_DIR/meta.txt"
set +e
bash "$APP/tests/run-all.sh" --fast --log "$RUN_DIR/run.log" > "$RUN_DIR/summary.txt" 2>&1
rc=$?
set -e
echo "runner exit: $rc" >> "$RUN_DIR/meta.txt"
cat "$RUN_DIR/summary.txt"
S="$RUN_DIR/summary.txt"; H="$RUN_DIR/honest-summary.txt"
# Fix 2: honest summary from tests/summarise-run.js (reads the runner output and accepted-results.json at run time).
set +e
node "$APP/tests/summarise-run.js" "$S" --accepted "$APP/tests/accepted-results.json" > "$H" 2>&1
frc=$?
set -e
echo "summariser exit: $frc" >> "$RUN_DIR/meta.txt"
cat "$H"
{
  echo "## Step 4: fast test tier"
  if [ "$frc" -ne 0 ]; then echo "### SUMMARY UNAVAILABLE (treat as FAILED)"; echo; cat "$H"; echo; fi
  if grep -q '^FAILED:' "$H"; then echo "### $(grep -m1 '^FAILED:' "$H")"; fi
  if grep -q -E '^(FAST|FULL):' "$H"; then echo "### $(grep -m1 -E '^(FAST|FULL):' "$H")"; fi
  grep -E '^(Full tier|Differs|Meaning):' "$H" | sed 's/$/  /' || true
  echo
  echo "$(grep -m1 '^Scope: ' "$S")"
  echo
  echo "Raw runner line (this fast run only): \`$(grep -m1 '^PASS: ' "$S")\`"
  echo
  echo "**$(grep -m1 '^EXIT ' "$S" || echo "runner exit $rc, no EXIT line: see the log")**"
  echo
  echo "Non-PASS rows and warnings:"; echo '```'
  grep -E '^(FAIL|ERROR|BLOCKED|REDUCED) |WARNING:' "$S" | cut -c1-160 || true
  echo '```'
  echo "<details><summary>All rows (expected and actual counts)</summary>"; echo; echo '```'
  sed -n '/^STATUS /,/^$/p' "$S" | cut -c1-120; echo '```'; echo "</details>"
  echo; echo "Run id \`$RUN_ID\`; full logs are in the artifact \`t2-evidence-$RUN_ID\`."
} >> "$GITHUB_STEP_SUMMARY"
if [ "$rc" -ne 0 ]; then exit "$rc"; fi
exit "$frc"
